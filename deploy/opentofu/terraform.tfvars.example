# Staging example — copy to staging.tfvars and fill in CHANGEME values.
# staging.tfvars is gitignored (*.tfvars). Never put secrets in any .tfvars.
region      = "ap-southeast-1"
environment = "staging"
project     = "quizforge"

instance_type = "t4g.small"
ebs_size_gb   = 20

# DNS: leave domain_name empty until the parent domain + zone exist.
domain_name = ""
subdomain   = "staging"

github_repo = "mddanish004/Quizmaster"
alert_email = "m.danishansari004@gmail.com"

budget_limit_usd      = "30"
backup_retention_days = 14
log_retention_days    = 14
ssm_path              = "quizforge/staging"
