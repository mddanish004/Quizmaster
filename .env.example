# Local defaults. Production values live in render.yaml + the Render dashboard
# (sync: false entries) and in GitHub Actions secrets for the deploy workflow.
# Never commit real secrets: .env is gitignored.
#
# Production topology: ONE Render web service (single Docker image serving the
# SPA + API on one origin) + managed Neon Postgres. Set APP_ORIGIN and
# WS_ALLOWED_ORIGINS to the Render URL (e.g. https://quizforge.onrender.com).

# Runtime
APP_ENV=development
APP_ORIGIN=http://localhost:5173
HTTP_ADDR=:8080
LOG_LEVEL=debug
LOG_FORMAT=json
TRUSTED_PROXY_CIDRS=172.16.0.0/12
SHUTDOWN_TIMEOUT=25s
# STATIC_DIR serves the built SPA (Vite dist). Set in the Docker image to
# /srv; leave unset for local dev where `vite dev` serves the UI.
STATIC_DIR=

# PostgreSQL (Neon: pooled URL for runtime, direct URL for migrations)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.neon.tech/DB?sslmode=require
MIGRATIONS_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.neon.tech/DB?sslmode=require
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

# Authentication
SESSION_COOKIE_NAME=__Host-qf_session
PARTICIPANT_COOKIE_NAME=__Host-qf_participant
SESSION_IDLE_TTL=24h
SESSION_ABSOLUTE_TTL=720h
CSRF_SECRET=
PASSWORD_PEPPER=

# Google OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Hugging Face Inference Providers
AI_PROVIDER=huggingface
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen3-32B
HF_PROVIDER=auto
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
AI_REQUEST_TIMEOUT=45s
AI_ENDPOINT_TIMEOUT=60s
AI_MAX_IN_FLIGHT=4
AI_DAILY_USER_LIMIT=5
AI_DAILY_IP_LIMIT=20
AI_STORE_CONTENT=false

# Email. mock logs nothing and captures links for tests; smtp uses any relay.
MAIL_PROVIDER=mock
MAIL_FROM=QuizForge AI <no-reply@example.com>
SMTP_ADDR=
SMTP_USERNAME=
SMTP_PASSWORD=

# Rate limits and live sessions
JOIN_CODE_TTL=6h
LIVE_SESSION_IDLE_TTL=2h
LIVE_SESSION_MAX_TTL=6h
WS_ALLOWED_ORIGINS=http://localhost:5173
WS_MAX_MESSAGE_BYTES=16384
WS_OUTBOUND_QUEUE=64
RATE_LIMIT_ENABLED=true

# Observability and build metadata
METRICS_ENABLED=true
METRICS_ADDR=127.0.0.1:9090
BUILD_VERSION=dev
BUILD_COMMIT=unknown

# Test-only; never point to production
TEST_DATABASE_URL=
TEST_DATABASE_URL_QUIZ=
TEST_DATABASE_URL_AI=
TEST_DATABASE_URL_LIVE=
TEST_DATABASE_URL_JANITOR=
E2E_BASE_URL=http://localhost:5173
MOCK_AI=true
MOCK_OIDC=true
MOCK_MAIL=true
